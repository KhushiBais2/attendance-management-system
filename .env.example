# =================================================================
# Multimodal Attendance & Engagement Agent - Environment Configuration
# =================================================================

# Google Gemini API Key (Optional)
# If provided, the system leverages Gemini 2.0 Flash for context-aware suggestions.
# If omitted, the deterministic 100% offline rule-based fallback agent operates automatically.
GEMINI_API_KEY=

# Automated Sustained Attendance Verification Threshold (in seconds)
# A learner must maintain uninterrupted presence exceeding this duration to receive "Present (Verified)".
SUSTAINED_ATTENDANCE_SECONDS=4.0

# Server Network Configuration
HOST=127.0.0.1
PORT=5000
FLASK_ENV=production
